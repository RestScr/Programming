<Window x:Class="View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:View"
        xmlns:databinding="clr-namespace:View.Converters"
        xmlns:ctrls="clr-namespace:View.Controls"
        mc:Ignorable="d"
        Title="Contacts" 
        Height="450" 
        Width="800" 
        Icon="/assets/ContactsApp_96x96.ico">

    <Window.Resources>
        <DataTemplate x:Key="ContactDataTemplate">
            <StackPanel
                Orientation="Horizontal">
                <!-- Изображение контакта с закругленными краями -->
                <Border
                    CornerRadius="50"
                    Width="40"
                    Height="40">
                    <Border.Background>
                        <ImageBrush
                            ImageSource="/assets/photo_placeholder_100x100.png"
                            Stretch="Fill"
                        />
                    </Border.Background>
                </Border>

                <!-- Блоки текста с именем и номером телефона контактов -->
                <StackPanel 
                    Margin="3"
                    Orientation="Vertical">
                    <TextBlock 
                        Text="{Binding Name}"
                        FontWeight="Bold"/>
                    <TextBlock 
                        Text="{Binding PhoneNumber}"/>
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <!-- Главный интерфейс окна -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition 
                Width="100*"
                />
            <ColumnDefinition 
                Width="154*"
                />
        </Grid.ColumnDefinitions>

        <GridSplitter 
            HorizontalAlignment="Left" 
            Height="450" 
            VerticalAlignment="Top" 
            Width="3" Grid.Column="1"/>
        <Border 
            Background="#F8F8F8"
            Grid.Column="0"/>
        <!-- Левая колонка -->
        <Grid Margin="8,8,8,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="33"/>
                <RowDefinition Height="364*"/>
                <RowDefinition Height="35"/>
            </Grid.RowDefinitions>
            <Grid
                Grid.Row="0"
                Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="41"/>
                    <ColumnDefinition Width="258*"/>
                </Grid.ColumnDefinitions>
                <Label 
                    Content="Find:"
                    Margin="3,3,3,3"
                    Grid.Column="0"
                    />
                <TextBox
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="3"
                    Text="{Binding TextFilter, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <!-- Список контактов -->
            <ListBox 
                Grid.Column="0"
                Grid.Row="1"
                ItemsSource="{Binding ContactsView}"
                SelectedItem="{Binding SelectedContact}"
                Margin="3"
                ItemTemplate="{StaticResource ContactDataTemplate}"
            />

            <!-- Набор кнопок добавления/редактирования/удаления-->
            <Grid
                Grid.Row="2"
                Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Button
                    Grid.Column="0"
                    Height="25"
                    Margin="3"
                    Content="Add"
                    Command="{Binding AddContactCommand}"
                    />
                <Button
                    Grid.Column="1"
                    Height="25"
                    Margin="3"
                    Content="Edit"
                    Command="{Binding EditContactCommand}"
                    CommandParameter="{Binding SelectedContact}"
                    />
                <Button
                    Grid.Column="2"
                    Height="25"
                    Margin="3"
                    Content="Remove"
                    Command="{Binding RemoveContactCommand}"
                    CommandParameter="{Binding SelectedContact}"
                    />
            </Grid>
        </Grid>
        
        <!-- Правая колонка -->
        <StackPanel
            Grid.Column="1">
            <ctrls:ContactControl
                DataContext="{Binding ContactViewModel}"
                x:Name="ContactControl"
            />
            <!-- Кнопка подтверждения -->
            <Button 
                Content="Apply"
                Grid.Column="1"
                Grid.Row="7"
                Height="25"
                Width="75" 
                Margin="140, 50, 3, 3"
                Command="{Binding ApplyContactCommand}" 
                CommandParameter="{Binding ContactViewModel.EditingContact}" 
                HorizontalAlignment="Left"
                IsEnabled="{Binding IsValid, 
                            ElementName=ContactControl}"
                >
            </Button>
        </StackPanel>
        
    </Grid>
</Window>
