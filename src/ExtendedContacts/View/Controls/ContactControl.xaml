<UserControl x:Class="View.Controls.ContactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Controls"
             xmlns:databinding="clr-namespace:View.ViewModel.Converters"
             xmlns:rules="clr-namespace:View.ViewModel.ValidationRules"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             >
    <UserControl.Resources>
        <!-- Добавление конвертера -->
        <databinding:ReverseBoolConverter
            x:Key="ReverseBoolConverter"
        />
        <databinding:ValidationConverter
            x:Key="ValidationConverter"
        />
        <Style TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="True">
                    <Setter 
                        Property="ToolTip"
                        Value="{Binding RelativeSource={RelativeSource Self}, 
                        Path=(Validation.Errors)[0].ErrorContent}"/>
                    <Setter Property="Background" Value="LightPink"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Правая колонка -->
        <Grid 
            Grid.Column="1"
            Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Orientation="Vertical"
                Grid.Column="0">
                <Image
                    Grid.RowSpan="4"
                    Grid.Row="1"
                    Grid.Column="0" 
                    Margin="3,35,3,3" 
                    Source="/assets/photo_placeholder_100x100.png"
                    />
            </StackPanel>

            <StackPanel
                Grid.Column="1">
                <!-- Ввод и отображение имени -->
                <Label
                    Grid.Column="1"
                    Grid.Row="0"
                    Content="Name:"
                    Margin="3,3,3,3" HorizontalAlignment="Left"/>
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="3,3,3,3"
                    IsReadOnly="{Binding EditMode, Converter={StaticResource ReverseBoolConverter}}"
                    x:Name="NameTextBox"
                    >
                    <TextBox.Text>
                        <Binding 
                            Path="EditingContact.Name"
                            UpdateSourceTrigger="PropertyChanged">
                            <Binding.ValidationRules>
                                <rules:NameRule/>
                            </Binding.ValidationRules>
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <!-- Ввод и отображение номера телефона -->
                <Label
                    Grid.Column="1"
                    Grid.Row="2"
                    Content="Phone Number:"
                    Margin="3,3,3,3" 
                    HorizontalAlignment="Left"/>
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="3,3,3,3"
                    IsReadOnly="{Binding EditMode, Converter={StaticResource ReverseBoolConverter}}"
                    Validation.ErrorTemplate="{x:Null}"
                    x:Name="PhoneNumberTextBox"
                    >
                    <Binding 
                        Path="EditingContact.PhoneNumber"
                        UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <rules:PhoneRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>

                <!-- Ввод и отображение электронной почты -->
                <Label
                    Grid.Column="1"
                    Grid.Row="4"
                    Content="Email:"
                    Margin="3,3,3,3" HorizontalAlignment="Left"/>
                <TextBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="3,3,3,3"
                    IsReadOnly="{Binding EditMode, Converter={StaticResource ReverseBoolConverter}}"
                    x:Name="EmailTextBox"
                    >
                    <Binding 
                        Path="EditingContact.Email"
                        UpdateSourceTrigger="PropertyChanged">
                        <Binding.ValidationRules>
                            <rules:EmailRule/>
                        </Binding.ValidationRules>
                    </Binding>
                </TextBox>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
