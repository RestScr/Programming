<UserControl x:Class="View.Controls.ContactControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:View.Controls"
             xmlns:databinding="clr-namespace:View.ViewModel.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <!-- Добавление конвертера -->
        <databinding:ReverseBoolConverter 
            x:Key="ReverseBoolConverter"
        />
    </UserControl.Resources>

    <Grid>
        <!-- Правая колонка -->
        <Grid 
            Grid.Column="1"
            Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel
                Orientation="Vertical"
                Grid.Column="0">
                <Image
                    Grid.RowSpan="4"
                    Grid.Row="1"
                    Grid.Column="0" 
                    Margin="3,35,3,3" 
                    Source="/assets/photo_placeholder_100x100.png"
                    />
            </StackPanel>

            <StackPanel
                Grid.Column="1">
                <!-- Ввод и отображение имени -->
                <Label
                    Grid.Column="1"
                    Grid.Row="0"
                    Content="Name:"
                    Margin="3,3,3,3" HorizontalAlignment="Left"/>
                <TextBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="3,3,3,3"
                    IsReadOnly="{Binding EditMode}"
                    >
                    <TextBox.Text>
                        <Binding Path="EditingContact.Name">
                            
                        </Binding>
                    </TextBox.Text>
                </TextBox>

                <!-- Ввод и отображение номера телефона -->
                <Label
                    Grid.Column="1"
                    Grid.Row="2"
                    Content="Phone Number:"
                    Margin="3,3,3,3" 
                    HorizontalAlignment="Left"/>
                <TextBox
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="3,3,3,3"
                    Text="{Binding EditingContact.PhoneNumber}"
                    IsReadOnly="{Binding EditMode, Converter=}"
                    />

                <!-- Ввод и отображение электронной почты -->
                <Label
                    Grid.Column="1"
                    Grid.Row="4"
                    Content="Email:"
                    Margin="3,3,3,3" HorizontalAlignment="Left"/>
                <TextBox
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="3,3,3,3"
                    Text="{Binding EditingContact.Email}"
                    IsReadOnly="{Binding EditMode}"
                    />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
